{
  "name": "prosper-racquet-league-platform",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "mobile",
    "shared"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:backend dev:mobile",
    "dev:backend": "npm --workspace backend run dev",
    "dev:mobile": "npm --workspace mobile run dev",
    "build": "npm-run-all build:shared build:backend build:mobile",
    "build:shared": "npm --workspace shared run build",
    "build:backend": "npm --workspace backend run build",
    "build:mobile": "npm --workspace mobile run build",
    "start": "npm --workspace backend run start",
    "lint": "npm-run-all lint:*",
    "lint:backend": "npm --workspace backend run lint",
    "lint:mobile": "npm --workspace mobile run lint",
    "lint:shared": "npm --workspace shared run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
